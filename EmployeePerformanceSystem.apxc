// ============================================================
//  Employee Performance Evaluation System
//  Go to: Setup → Apex Classes → New → Paste this → Save
// ============================================================

public class EmployeePerformanceSystem {

    public static void evaluateEmployee(String name, Integer score) {

        System.debug('--- Employee Performance Report ---');
        System.debug('Employee Name: ' + name);
        System.debug('Performance Score: ' + score);

        if(score >= 90) {
            System.debug('Performance: Excellent');
            System.debug('Bonus Awarded');
        }

        else if(score >= 60) {
            System.debug('Performance: Good');
            System.debug('Average Bonus Awarded');
        }

        else {
            System.debug('Performance: Needs Improvement');
        }
    }
}

// ============================================================
//  Execute in Developer Console → Execute Anonymous Window:
// ============================================================
//  EmployeePerformanceSystem.evaluateEmployee('Amit', 92);
// ============================================================
