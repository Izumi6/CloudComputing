// ============================================================
//  Hospital Management System
//  Go to: Setup → Apex Classes → New → Paste this → Save
// ============================================================

public class HospitalManagement {

    public static void checkPatient(String patientName, Integer temperature, Integer age) {

        System.debug('--- Patient Report ---');
        System.debug('Patient Name: ' + patientName);
        System.debug('Age: ' + age);
        System.debug('Body Temperature: ' + temperature);

        if(temperature > 100) {
            System.debug('Diagnosis: Fever Detected');
            System.debug('Medicine Suggested: Paracetamol');
        }

        else {
            System.debug('Diagnosis: Patient Normal');
        }

        if(age > 60) {
            System.debug('Special Care Required for Senior Citizen');
        }
    }
}

// ============================================================
//  Execute in Developer Console → Execute Anonymous Window:
// ============================================================
//  HospitalManagement.checkPatient('Ramesh', 102, 65);
// ============================================================
